# 应用
APP_ENV=dev
APP_DATA_DIR=./data
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://127.0.0.1:5173"]

# 鉴权（生产必须替换）
APP_JWT_SECRET=change-me-in-production
APP_ACCESS_TTL_SECONDS=900
APP_REFRESH_TTL_SECONDS=2592000

# 模型（阈值/版本以 app_config 为准，见架构 6.1）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 权重缓存目录以 app_config 的 llm.embedding.cache_dir 为准（默认 backend/data/models）
# 国内网络可取消下行注释使用 HF 镜像；手动下载见 backend/README.md
# HF_ENDPOINT=https://hf-mirror.com
# 模型已手动下载齐全、不想再联网时打开：
# HF_HUB_OFFLINE=1

# 上传限制
APP_UPLOAD_MAX_MB=50
